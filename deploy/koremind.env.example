# /etc/koremind/koremind.env  (chmod 640, owner root, group koremind)
# Absolute path: the default (./data) depends on the working directory.
KOREMIND_DATA_DIR=/var/lib/koremind
KOREMIND_PORT=8787
KOREMIND_WEB_PORT=3210

# Full path to the OpenCode binary (find it with: sudo -u koremind -i command -v opencode)
KOREMIND_OPENCODE_BIN=/home/koremind/.opencode/bin/opencode

# Set when KoreMind is reachable at a public address (Cloudflare tunnel, your own domain).
# It is shown by the backend and put into phone-pairing QR codes.
#KOREMIND_PUBLIC_URL=https://api.koremind.example.com

# Only when a proxy on ANOTHER machine terminates TLS in front of KoreMind.
#KOREMIND_TRUST_PROXY=1

# --- Kore ID single sign-on (see docs/kore-id.md). Off while KOREMIND_OIDC_ISSUER is unset. ---
#KOREMIND_OIDC_ISSUER=https://id.kore.example
#KOREMIND_OIDC_CLIENT_ID=koremind
# The client secret Kore ID printed for "koremind". Keep this file chmod 640. Or point at a file instead:
#KOREMIND_OIDC_CLIENT_SECRET=
#KOREMIND_OIDC_CLIENT_SECRET_FILE=/etc/koremind/oidc-secret
# Default: $KOREMIND_PUBLIC_URL/auth/callback. Register exactly this in Kore ID.
#KOREMIND_OIDC_REDIRECT_URI=https://api.koremind.example.com/auth/callback
# Where the web UI lives (comma separated origins). Default: localhost only.
#KOREMIND_WEB_ORIGINS=https://koremind.example.com
# Who may get an account on first sign-in. The very first Kore ID user becomes the owner.
# Either a list (emails or @domains)...
#KOREMIND_OIDC_ALLOWED_EMAILS=me@example.com,@family.example
# ...or let anyone with a Kore ID in (only if that is what you want):
#KOREMIND_OIDC_AUTO_PROVISION=1
# Link a Kore ID to an existing local account with the same email. Kore ID does not verify emails yet: leave off
# unless Kore ID sign-up is closed. Safe alternative: sign in with the password, Settings -> Account -> Link Kore ID.
#KOREMIND_OIDC_TRUST_EMAIL_LINK=1
# 0 = email + password sign-in and registration off (Kore ID only).
#KOREMIND_PASSWORD_LOGIN=0
