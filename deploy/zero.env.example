# /etc/zero/zero.env  (chmod 640, owner root, group zero)
# Absolute path: the default (./data) depends on the working directory.
ZERO_DATA_DIR=/var/lib/zero
ZERO_PORT=8787
ZERO_WEB_PORT=3210

# Full path to the OpenCode binary (find it with: sudo -u zero -i command -v opencode)
ZERO_OPENCODE_BIN=/home/zero/.opencode/bin/opencode

# Set when Zero is reachable at a public address (Cloudflare tunnel, your own domain).
# It is shown by the backend and put into phone-pairing QR codes.
#ZERO_PUBLIC_URL=https://api.zero.example.com

# Only when a proxy on ANOTHER machine terminates TLS in front of Zero.
#ZERO_TRUST_PROXY=1
