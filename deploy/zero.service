# /etc/systemd/system/zero.service
# Runs the Zero backend (:8787) and web UI (:3210). See docs/deployment-linux.md.
[Unit]
Description=Zero personal assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zero
Group=zero
WorkingDirectory=/opt/zero
EnvironmentFile=/etc/zero/zero.env
# systemd gives services a minimal PATH: bun and opencode live in the zero user's home.
Environment=PATH=/home/zero/.bun/bin:/home/zero/.opencode/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/zero/.bun/bin/bun run start
Restart=on-failure
RestartSec=3
# Stop the whole group so the OpenCode engine process never outlives the backend.
KillMode=control-group
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
